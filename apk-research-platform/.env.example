# APK Research Platform - environment template
#
# Copy to .env (same folder as this file) and adjust. Every value below is the
# built-in default; an empty value means "use the default". Nothing secret is
# committed - APKPLAT_SECRET and APKPLAT_MODEL_API_KEY stay out of the repo.

# -- storage and reports ------------------------------------------------------
APKPLAT_STORAGE=D:\ADeespseekSH\REA\apk-research-platform\storage
APKPLAT_REPORTS=D:\ADeespseekSH\REA\apk-research-platform\reports
APKPLAT_TOOLS=D:\ADeespseekSH\REA\apk-research-platform\tools

# Explicit database URL. Empty = sqlite:///<APKPLAT_STORAGE>/platform.db
# A PostgreSQL URL is accepted by the code path but is untested on this host
# (no server available); SQLite is the supported default.
APKPLAT_DB_URL=

# -- http surface -------------------------------------------------------------
APKPLAT_HOST=127.0.0.1
APKPLAT_PORT=8765
APKPLAT_PUBLIC_URL=http://127.0.0.1:8765

# 1 = bearer tokens required, 0 = local single-operator mode (no token checks).
# Local mode is what the UI uses on a workstation; keep 1 when exposing a port.
APKPLAT_REQUIRE_AUTH=0

# Signing/root secret. Empty = a random key is generated once into
# <APKPLAT_STORAGE>/secret.key and reused. Set it to a long random string when
# several processes must validate each other's tokens.
APKPLAT_SECRET=
APKPLAT_TOKEN_TTL=43200

# -- concurrency (taskbook initial values) -----------------------------------
APKPLAT_STATIC_WORKERS=2
APKPLAT_DYNAMIC_WORKERS=1
APKPLAT_REPORT_WORKERS=1
APKPLAT_MODEL_CONCURRENCY=1

# -- leases and limits --------------------------------------------------------
APKPLAT_JOB_LEASE_SECONDS=300
APKPLAT_DEVICE_LEASE_SECONDS=900
APKPLAT_MAX_UPLOAD_MB=512
APKPLAT_MAX_UNZIPPED_MB=2048

# -- restricted toolchain -----------------------------------------------------
APKPLAT_JADX_TIMEOUT=900
APKPLAT_APKTOOL_TIMEOUT=900
APKPLAT_JADX_HEAP=-Xmx1200m

# -- model API (operator-provided; this project never installs or reconfigures it)
# Empty base URL = probe 127.0.0.1:8788, then 192.168.43.1:8788.
APKPLAT_MODEL_BASE_URL=http://192.168.43.1:8788/v1
# Empty key = read refs.WB_PROXY_API_KEY from C:\Users\YHY\.dsh\.credentials.yaml
APKPLAT_MODEL_API_KEY=
APKPLAT_MODEL_ID=deepseek-v4.1-flash
APKPLAT_MODEL_TIMEOUT=180
APKPLAT_MODEL_ENABLED=1
APKPLAT_MODEL_MAX_TOKENS=3000

# -- dynamic analysis ---------------------------------------------------------
# adb = real device pool, sim = deterministic simulator (used by the tests and
# by gate4 on a host with no attached device)
APKPLAT_DYNAMIC_TRANSPORT=sim
APKPLAT_DYNAMIC_STEP_TIMEOUT=120
APKPLAT_DYNAMIC_OBSERVE_SECONDS=5
APKPLAT_DYNAMIC_LOG_TAIL=400

# -- MCP server (read by mcp-server/mcp_server/server.py, not by the API) ------
# Comma-separated project ids the MCP process may touch; * only for a trusted
# single-operator workstation.
APKPLAT_MCP_PROJECTS=*
APKPLAT_MCP_ACTOR=mcp-agent
